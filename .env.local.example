# Generated from this file on first start. Never commit .env.local.
# Node.js 22+ and Docker Compose v2. Run: node ops/local.mjs start
POSTGRES_PASSWORD=__GENERATE__
APP_ENCRYPTION_KEY=__GENERATE__
WORKER_TOKEN=__GENERATE__
ZAP_API_KEY=__GENERATE__

# Optional. The UI and deterministic tools work without AI keys.
# Choose model IDs supported by your provider account.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# OrcaRouter Cyber Inference (named provider). Paste a key here or use the
# Setup & models panel, which also supports OAuth 2.0 + PKCE.
# Provider: https://www.orcarouter.ai/cyber
# Cyber catalog: https://www.orcarouter.ai/models?tier=cyber
ORCAROUTER_API_KEY=
# LLM_LOW_REASONING_PROVIDER=orcarouter
# LLM_LOW_REASONING_MODEL=orcarouter/auto
# LLM_HIGH_REASONING_PROVIDER=orcarouter
# LLM_HIGH_REASONING_MODEL=orcarouter/auto
LLM_LOW_REASONING_PROVIDER=deepseek
LLM_LOW_REASONING_MODEL=deepseek-chat
LLM_HIGH_REASONING_PROVIDER=deepseek
LLM_HIGH_REASONING_MODEL=deepseek-reasoner
LLM_LOW_REASONING_FALLBACK_PROVIDER=
LLM_LOW_REASONING_FALLBACK_MODEL=
LLM_HIGH_REASONING_FALLBACK_PROVIDER=
LLM_HIGH_REASONING_FALLBACK_MODEL=

# Optional advanced tool adapters, installed separately on the Docker host.
# O/S report tool-unavailable unless a real runtime is provided here.
OPENHACK_INTEGRATION_URL=http://host.docker.internal:6120
STRIX_INTEGRATION_URL=http://host.docker.internal:6130
