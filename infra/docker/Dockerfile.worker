# Generic worker image. The WORKER_KIND env decides which worker to run.
# Browser-based workers (scan-orchestrator + browser-inspector) need Playwright
# system dependencies — we install chromium-bundled deps via playwright's installer.

FROM node:22-slim AS base
ENV NODE_ENV=production CI=true
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY apps ./apps/
COPY packages ./packages/
COPY workers ./workers/
RUN pnpm install --frozen-lockfile --prod=false
RUN pnpm --filter @x-hunter/db run generate

FROM deps AS chromium
# Pull system dependencies and the bundled Chromium for Playwright.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 libpangocairo-1.0-0 libpango-1.0-0 libcairo2 fonts-liberation \
    libxshmfence1 ca-certificates wget tzdata curl \
  && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pnpm exec playwright install chromium

FROM chromium AS runner
ENV NODE_ENV=production
WORKDIR /app
ENV WORKER_KIND=scan-orchestrator
CMD ["sh", "-lc", "case \"$WORKER_KIND\" in scan-orchestrator) exec pnpm --filter @x-hunter/scan-orchestrator run dev ;; retest) exec pnpm --filter @x-hunter/retest-worker run dev ;; *) echo unknown WORKER_KIND=$WORKER_KIND; exit 1 ;; esac"]
