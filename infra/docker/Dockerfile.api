# Production-ish image for the Fastify API. Uses pnpm + node:22-slim base.
# Multi-stage: install deps once, then build, then ship a slim runtime layer.

FROM node:22-slim AS base
ENV NODE_ENV=production CI=true
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages ./packages/
COPY workers ./workers/
RUN pnpm install --frozen-lockfile --prod=false

FROM deps AS build
COPY . .
RUN pnpm --filter @x-hunter/db run generate
RUN pnpm --filter @x-hunter/api run build

FROM node:22-slim AS runner
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate
WORKDIR /app
COPY --from=build /app /app
EXPOSE 3000
CMD ["node", "apps/api/dist/server.js"]
