# =============================================================================
# X-hunter AI — environment variables example.
# Copy to .env at the repo root and fill in values for local dev.
# Never commit .env. Never log raw values from these variables.
# =============================================================================

# ---- App ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Database ----
# Postgres connection string used by Prisma and the API.
DATABASE_URL=postgresql://xhunter:xhunter@localhost:5432/xhunter?schema=public

# ---- Redis (queues, rate limiting, scan progress) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (S3-compatible; use MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=xhunter
S3_SECRET_ACCESS_KEY=xhunter-dev
S3_BUCKET_EVIDENCE=xhunter-evidence
S3_BUCKET_REPORTS=xhunter-reports

# ---- Auth & crypto ----
# 32-byte random hex (64 chars). Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# JWT signing secret (any high-entropy string).
APP_JWT_SECRET=
# Session cookie name.
APP_SESSION_COOKIE=xhunter_session

# ---- Domain verification ----
VERIFICATION_TOKEN_PREFIX=xhunter-verify
VERIFICATION_TXT_RECORD_NAME=_xhunter-verification
VERIFICATION_WELL_KNOWN_PATH=.well-known/xhunter-verification.txt

# ---- LLM providers ----
# Leave blank to disable a provider. The LLM Gateway will fall through to the
# next configured provider per the alias config (see packages/llm-gateway/config).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FREE_SUMMARY_MODEL=gpt-4o-mini
OPENAI_STANDARD_REASONING_MODEL=gpt-4o
OPENAI_AUTH_REASONING_MODEL=gpt-4o
OPENAI_REPORT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_STANDARD_REASONING_MODEL=claude-3-5-sonnet-latest
CLAUDE_AUTH_REASONING_MODEL=claude-3-5-sonnet-latest

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FREE_SUMMARY_MODEL=deepseek-chat
DEEPSEEK_REPORT_MODEL=deepseek-chat

# ---- Scanner integrations ----
# ZAP daemon (HTTP API). Optional in dev; if unset, zap-signal worker reports
# a structured "tool unavailable" error and does not fake success.
ZAP_BASE_URL=http://localhost:8090
ZAP_API_KEY=

# Nuclei CLI binary path. Optional; worker will look up `nuclei` on PATH.
NUCLEI_BIN=nuclei
NUCLEI_TEMPLATES_DIR=

# OpenHack CLI workspace root (path to a checkout of openhack).
OPENHACK_ROOT=
OPENHACK_BIN=openhack

# Strix CLI (optional).
STRIX_BIN=strix

# ---- Observability ----
LOG_LEVEL=info
