{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhunter.local/schemas/country-security-catalog-v1",
  "title": "Pinned country security framework reference catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "reviewedOn",
    "controlAreas",
    "frameworks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "country_security_catalog_v1"
    },
    "catalogVersion": {
      "type": "string",
      "maxLength": 64
    },
    "reviewedOn": {
      "type": "string",
      "format": "date"
    },
    "controlAreas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "evidenceKinds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidenceKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "configuration",
                "policy_document",
                "independent_review",
                "scan_metadata"
              ]
            }
          }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "countryCode",
          "countryName",
          "label",
          "version",
          "kind",
          "ordinalLevels",
          "currency",
          "applicability",
          "levelSelection",
          "levels",
          "controlIds",
          "mappingCoverage",
          "sources",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "countryName": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "impact_classification",
              "maturity",
              "governance_tier",
              "certification_assurance",
              "preparedness_certification",
              "implementation_approach",
              "self_declaration",
              "control_baseline",
              "regulatory_requirements"
            ]
          },
          "ordinalLevels": {
            "type": "boolean"
          },
          "currency": {
            "enum": [
              "reviewed_reference",
              "requires_review"
            ]
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          },
          "levelSelection": {
            "enum": [
              "owner_or_authority",
              "assessment_target"
            ]
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "summary"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "controlIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            }
          },
          "mappingCoverage": {
            "enum": [
              "partial",
              "overview_only"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "url",
                "locator"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "jurisdictionType": {
            "enum": [
              "country_or_area",
              "supranational",
              "international"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "countryCode": {
                  "const": "EU"
                }
              }
            },
            "then": {
              "required": [
                "jurisdictionType"
              ],
              "properties": {
                "jurisdictionType": {
                  "const": "supranational"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "countryCode": {
                  "const": "ZZ"
                }
              }
            },
            "then": {
              "required": [
                "jurisdictionType"
              ],
              "properties": {
                "jurisdictionType": {
                  "const": "international"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "countryCode": {
                  "not": {
                    "enum": [
                      "EU",
                      "ZZ"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "jurisdictionType": {
                  "const": "country_or_area"
                }
              }
            }
          }
        ]
      }
    }
  }
}
