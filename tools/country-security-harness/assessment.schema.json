{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhunter.local/schemas/country-security-assessment-v1",
  "title": "Offline declared country-framework evidence coverage; no formal level determination",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "catalogReviewedOn",
    "asOf",
    "dataOrigin",
    "assessmentId",
    "countryCode",
    "countryName",
    "applicabilityConfirmed",
    "conclusion",
    "formalLevelDetermination",
    "levelSource",
    "framework",
    "controls",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "country_security_assessment_v1"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "catalogReviewedOn": {
      "type": "string",
      "format": "date"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "dataOrigin": {
      "enum": [
        "synthetic_fixture",
        "operator_supplied"
      ]
    },
    "assessmentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "countryName": {
      "type": "string",
      "minLength": 1
    },
    "applicabilityConfirmed": {
      "type": "boolean"
    },
    "conclusion": {
      "const": "not_determined"
    },
    "formalLevelDetermination": {
      "const": false
    },
    "levelSource": {
      "const": "operator_selected"
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "version",
        "kind",
        "ordinalLevels",
        "currency",
        "applicability",
        "levelSelection",
        "mappingCoverage",
        "selectedLevel",
        "sources",
        "jurisdictionType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "impact_classification",
            "maturity",
            "governance_tier",
            "certification_assurance",
            "preparedness_certification",
            "implementation_approach",
            "self_declaration",
            "control_baseline",
            "regulatory_requirements"
          ]
        },
        "ordinalLevels": {
          "type": "boolean"
        },
        "currency": {
          "enum": [
            "reviewed_reference",
            "requires_review"
          ]
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "levelSelection": {
          "enum": [
            "owner_or_authority",
            "assessment_target"
          ]
        },
        "mappingCoverage": {
          "enum": [
            "partial",
            "overview_only"
          ]
        },
        "selectedLevel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "summary"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "url",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "jurisdictionType": {
          "enum": [
            "country_or_area",
            "supranational",
            "international"
          ]
        }
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controlId",
          "label",
          "state",
          "metadataEvidenceAccepted",
          "gaps"
        ],
        "properties": {
          "controlId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "reported_satisfied",
              "reported_failed",
              "not_assessed",
              "not_applicable"
            ]
          },
          "metadataEvidenceAccepted": {
            "type": "boolean"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z_]+$"
            }
          },
          "reasonCode": {
            "enum": [
              "outside_declared_system",
              "missing_prerequisite",
              "manual_review_required"
            ]
          },
          "evidenceKind": {
            "enum": [
              "configuration",
              "policy_document",
              "independent_review",
              "scan_metadata"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
            }
          },
          "observedAt": {
            "type": "string",
            "format": "date"
          },
          "expiresAt": {
            "type": "string",
            "format": "date"
          },
          "reportedStatus": {
            "enum": [
              "reported_satisfied",
              "reported_failed"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappedControlCount",
        "reportedSatisfiedCount",
        "reportedFailedCount",
        "notAssessedCount",
        "notApplicableCount",
        "metadataAcceptedCount",
        "gaps"
      ],
      "properties": {
        "mappedControlCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "reportedSatisfiedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "reportedFailedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "notAssessedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "notApplicableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "metadataAcceptedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "controlId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
