        "applicabilityConfirmed",
        "conclusion",
        "formalLevelDetermination",
        "contentVerified",
        "independentlyValidated",
        "coverage",
        "clauses",
        "sources",
        "limitations",
        "packSha256",
        "frameworkCurrency",
        "frameworkKind",
        "jurisdictionType"
      ],
      "properties": {
