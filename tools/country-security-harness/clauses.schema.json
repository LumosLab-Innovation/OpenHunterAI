                "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
              },
              "value": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                    "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                  }
                ]
              }
            }
          },
          "minItems": 0,
          "maxItems": 200
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factId",
              "value",
              "kind",
              "evidenceRefs",
              "observedAt",
              "expiresAt"
            ],
            "properties": {
              "factId": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
              },
              "value": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                    "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                  }
                ]
              },
              "kind": {
                "enum": [
                  "configuration",
                  "policy_document",
                  "independent_review",
                  "scan_metadata"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^(?!(?:https?|file|ftp|s3|gs|data|javascript|wss?):)(?![a-z]:)(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*(?:^|[._:-])(?:token|password|secret|credential|bearer)(?:$|[._:-]))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._:-]{0,127}$",
                  "description": "Opaque non-sensitive artifact ID, including colon-delimited http_exchange references; never a URL, path, email or token."
                },
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true
              },
              "observedAt": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "expiresAt": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "packVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "packSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
