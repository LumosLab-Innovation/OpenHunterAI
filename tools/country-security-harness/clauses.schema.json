{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhunter.local/contracts/country-security-clauses.schema.json",
  "title": "Curated clauses, declared evidence and partial assessment",
  "oneOf": [
    {
      "$ref": "#/$defs/pack"
    },
    {
      "$ref": "#/$defs/evidence"
    },
    {
      "$ref": "#/$defs/assessment"
    }
  ],
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packId",
        "frameworkId",
        "version",
        "reviewedOn",
        "coverage",
        "sources",
        "limitations",
        "requirements"
      ],
      "properties": {
        "schemaVersion": {
          "const": "country_security_requirement_pack_v1"
        },
        "packId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
          "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
        },
        "frameworkId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
          "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "reviewedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "coverage": {
          "const": "partial"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "url",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2000
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "minItems": 1,
          "maxItems": 50
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "minItems": 1,
          "maxItems": 100
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "controlId",
              "levels",
              "levelBasis",
              "sourceId",
              "locator",
              "normativeStrength",
              "applicability",
              "check",
              "evidenceKinds",
              "interpretationNotes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "controlId": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                  "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "levelBasis": {
                "enum": [
                  "explicit_clause",
                  "framework_wide",
                  "cumulative_minimum"
                ]
              },
              "sourceId": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "normativeStrength": {
                "enum": [
                  "mandatory",
                  "recommendation"
                ]
              },
              "applicability": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "factId",
                    "equals"
                  ],
                  "properties": {
                    "factId": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                      "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                    },
                    "equals": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                          "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                        }
                      ]
                    }
                  }
                },
                "minItems": 0,
                "maxItems": 20
              },
              "check": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "factId",
                      "expected"
                    ],
                    "properties": {
                      "type": {
                        "const": "boolean"
                      },
                      "factId": {
                        "type": "string",
                        "maxLength": 64,
                        "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                        "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                      },
                      "expected": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "factId",
                      "max",
                      "unit"
                    ],
                    "properties": {
                      "type": {
                        "const": "number"
                      },
                      "factId": {
                        "type": "string",
                        "maxLength": 64,
                        "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                        "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                      },
                      "max": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "enum": [
                          "days",
                          "hours",
                          "months",
                          "count",
                          "bits"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "factId",
                      "allowedValues"
                    ],
                    "properties": {
                      "type": {
                        "const": "enum"
                      },
                      "factId": {
                        "type": "string",
                        "maxLength": 64,
                        "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                        "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                      },
                      "allowedValues": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
                          "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
                        },
                        "minItems": 1,
                        "maxItems": 100,
                        "uniqueItems": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "reviewTopic"
                    ],
                    "properties": {
                      "type": {
                        "const": "manual"
                      },
                      "reviewTopic": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    }
                  }
                ]
              },
              "evidenceKinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "configuration",
                    "policy_document",
                    "independent_review",
                    "scan_metadata"
                  ]
                },
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true
              },
              "interpretationNotes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "minItems": 1,
          "maxItems": 1000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "dataOrigin",
        "assessmentId",
        "packId",
        "levelId",
        "applicabilityConfirmed",
        "context",
        "observations",
        "packVersion",
        "packSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "country_security_clause_evidence_v1"
        },
        "dataOrigin": {
          "enum": [
            "synthetic_fixture",
            "operator_supplied"
          ]
        },
        "assessmentId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
          "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs.",
          "allOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^(?!(?:https?|file|ftp|s3|gs|data|javascript|wss?):)(?![a-z]:)(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*(?:^|[._:-])(?:token|password|secret|credential|bearer)(?:$|[._:-]))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._:-]{0,127}$",
              "description": "Opaque non-sensitive artifact ID, including colon-delimited http_exchange references; never a URL, path, email or token."
            }
          ]
        },
        "packId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
          "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
        },
        "levelId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?!.*(?:^|[._:-])(?:sk-|gh[pous]_|xox[abpr]-|eyj[a-z0-9_-]{16}|akia[a-z0-9]{16}|asia[a-z0-9]{16}|aiza[a-z0-9_-]{30}))(?!.*[a-f0-9]{32,})[a-z][a-z0-9._-]{0,63}$",
          "description": "Opaque non-sensitive identifier; no URL, filesystem path, email or token. Use lowercase IDs."
