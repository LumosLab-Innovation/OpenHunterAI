NODE_ENV=development
SERVICE_NAME=public-api
API_PORT=4000
DATABASE_URL=postgresql://xhunter:xhunter@localhost:5432/xhunter?schema=public
NATS_URL=nats://localhost:4222
APP_JWT_SECRET=dev-only-rotate-me
APP_SESSION_COOKIE=xhunter_session
VERIFICATION_TOKEN_PREFIX=xhunter-verify
VERIFICATION_TXT_RECORD_NAME=_xhunter-verification
VERIFICATION_WELL_KNOWN_PATH=.well-known/xhunter-verification.txt

# --- Payments (OWNER must fill before enabling billing) ---
# SePay (VND one-time / credit top-up via bank transfer + VietQR webhook).
SEPAY_WEBHOOK_APIKEY=
# Optional HMAC secret if your SePay account signs the raw body.
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=
# Polar (international subscriptions, Merchant-of-Record).
POLAR_WEBHOOK_SECRET=
# Map Polar product ids to package tiers: productId:tier,productId:tier
POLAR_PRODUCT_MAP=
# Organization access token for creating checkout sessions (Settings > Developers).
POLAR_ACCESS_TOKEN=
# Polar API base; override only for sandbox/testing.
POLAR_API_BASE=https://api.polar.sh
# Where Polar redirects after successful checkout.
POLAR_DEFAULT_SUCCESS_URL=
